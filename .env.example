DATABASE_URL="postgresql://seo_app:change-me@localhost:5432/seo_visibility?schema=public"
SESSION_COOKIE_NAME="seo_session"
SESSION_TTL_HOURS="12"
APP_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Required only by scripts/bootstrap-owner.ts
BOOTSTRAP_AGENCY_NAME="Example Agency"
BOOTSTRAP_OWNER_EMAIL="owner@example.com"
BOOTSTRAP_OWNER_PASSWORD="replace-with-a-long-random-password"

# Phase B2 worker (run separately with: npm run worker:inspection)
INSPECTION_WORKER_ID="local-worker-1"
INSPECTION_GLOBAL_CONCURRENCY="4"
INSPECTION_PER_CLIENT_CONCURRENCY="2"
INSPECTION_QUEUE_LIMIT_PER_CLIENT="500"
INSPECTION_LEASE_SECONDS="180"
INSPECTION_POLL_MS="2000"
INSPECTION_ORIGIN_DELAY_MS="1500"
INSPECTION_CONNECT_TIMEOUT_MS="5000"
INSPECTION_TOTAL_TIMEOUT_MS="15000"
INSPECTION_MAX_BYTES="2000000"
INSPECTION_MAX_REDIRECTS="5"
INSPECTION_EVIDENCE_TTL_HOURS="168"
INSPECTION_USER_AGENT="RobotlinkTechnicalInspector/1.0 (+https://your-domain.example/inspector)"
